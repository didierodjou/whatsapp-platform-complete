# --- Serveur ---
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3001

# --- Base de données ---
# Avec le docker-compose.yml fourni (docker compose up -d) :
DATABASE_URL=postgres://whatsapp_agent:whatsapp_agent@localhost:5433/whatsapp_agent

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Fournisseur du modèle de conversation ---
# anthropic (défaut, payant) ou gemini (palier gratuit Google AI Studio).
# Les deux exposent les mêmes tools et les mêmes messages de repli.
LLM_PROVIDER=anthropic

# --- Anthropic (si LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Google Gemini (si LLM_PROVIDER=gemini) ---
# Clé gratuite : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- WhatsApp Business Cloud API (Meta) ---
WHATSAPP_VERIFY_TOKEN=un_token_secret_choisi_par_vous
WHATSAPP_APP_SECRET=xxxxx
WHATSAPP_ACCESS_TOKEN=xxxxx
WHATSAPP_API_VERSION=v20.0
# Test uniquement : redirige TOUS les envois vers ce numero (jamais vers le
# vrai contact). Utile en developpement, et pour les numeros de test Meta dont
# la liste blanche exige une forme precise du numero. Vide en production.
WHATSAPP_RECIPIENT_OVERRIDE=

# --- Google Calendar (OAuth2) ---
GOOGLE_CLIENT_ID=xxxxx
GOOGLE_CLIENT_SECRET=xxxxx
GOOGLE_REDIRECT_URI=http://localhost:3001/oauth/google/callback

# --- HubSpot ---
HUBSPOT_ACCESS_TOKEN=xxxxx

# --- Escalade (notifications) ---
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
ESCALATION_EMAIL_FROM=agent@votre-domaine.com
ESCALATION_EMAIL_TO=

# --- Embeddings RAG ---
VOYAGE_API_KEY=

# --- Sécurité ---
# Génère avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Admin ---
ADMIN_API_KEY=changez_moi
